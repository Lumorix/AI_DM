[
 {
  "start": 0.0,
  "end": 2.6,
  "text": "スワイプしようとしているそこの君",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 2.6,
  "end": 4.78,
  "text": "もう遅い時間だよ",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 4.78,
  "end": 8.34,
  "text": "今日は無理せずぐっすり寝ちゃおうね",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 8.34,
  "end": 10.06,
  "text": "やおやろ",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 10.06,
  "end": 14.6,
  "text": "仮想空間つくやみ管理人のレナミヤチオでーす",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 14.6,
  "end": 16.44,
  "text": "なんと8000歳",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 16.44,
  "end": 19.56,
  "text": "歌って踊れるAIライバー",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 19.56,
  "end": 21.18,
  "text": "分身もできちゃうよ",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 21.18,
  "end": 24.14,
  "text": "8000歳って設定?ババアすぎん",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 24.14,
  "end": 25.12,
  "text": "こらー",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 25.12,
  "end": 26.580000000000002,
  "text": "置いたはダメだよ",
  "avg_logprob": -0.2234326876126803,
  "no_speech_prob": 1.369186534982969e-11
 },
 {
  "start": 26.58,
  "end": 30.099999999999998,
  "text": "本当にヤチオは縄文時代から生きてるんだ",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 30.099999999999998,
  "end": 35.239999999999995,
  "text": "8000年分の知識と経験でどんなお悩み相談もお任せあれ",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 35.239999999999995,
  "end": 39.76,
  "text": "なんだか孤独になっちゃった夜はヤチオに声を聞かせてね",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 39.76,
  "end": 41.86,
  "text": "ヤチオ寝る時間になっちゃった",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 41.86,
  "end": 45.239999999999995,
  "text": "みんな夜更かししすぎず寝るんだよ",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 45.239999999999995,
  "end": 48.18,
  "text": "それじゃさらばーい",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 48.18,
  "end": 53.3,
  "text": "ゲームしてる普通の女子高生ありけり",
  "avg_logprob": -0.11825127410888672,
  "no_speech_prob": 8.439498232204468e-12
 },
 {
  "start": 53.3,
  "end": 56.82,
  "text": "子供の母親との相性最悪だったため",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 56.82,
  "end": 59.699999999999996,
  "text": "身一つで生きてゆかんと状況せり",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 59.699999999999996,
  "end": 62.959999999999994,
  "text": "せっせとそれはそれはせっせとバイトし",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 62.959999999999994,
  "end": 67.67999999999999,
  "text": "生活費と学費を稼ぎなんとか生計を盾に切り",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 67.67999999999999,
  "end": 71.96,
  "text": "学校ではまさに採植顕微分部両党",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 71.96,
  "end": 75.6,
  "text": "他の生徒たちも憧れる優等生",
  "avg_logprob": -0.27620258846798457,
  "no_speech_prob": 2.5870141098782717e-11
 },
 {
  "start": 75.6,
  "end": 79.11999999999999,
  "text": "その他は予習したり",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 79.11999999999999,
  "end": 82.96,
  "text": "押し活したり黄昏たりゲームしたり",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 82.96,
  "end": 86.33999999999999,
  "text": "押し活したりして過ごしていました",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 86.33999999999999,
  "end": 90.75999999999999,
  "text": "なおば逆よりイロハとなん言いける",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 90.75999999999999,
  "end": 93.11999999999999,
  "text": "イロハって呼ぶべし",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 93.11999999999999,
  "end": 98.78,
  "text": "そんなめちゃがんばりイロハのいつも通りのある日の",
  "avg_logprob": -0.18297610440097012,
  "no_speech_prob": 3.2451340226113956e-11
 },
 {
  "start": 98.78,
  "end": 105.24,
  "text": "元七色に光るゲーミング電柱なん一筋ありける",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 105.24,
  "end": 107.8,
  "text": "怪しがりて寄りてみるに",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 107.8,
  "end": 111.4,
  "text": "太陽が沈んで夜がやってきます",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 111.4,
  "end": 114.3,
  "text": "仮想空間つくよみへようこそ",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 114.3,
  "end": 116.8,
  "text": "管理人のルナミヤチョウでーす",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 116.8,
  "end": 118.64,
  "text": "このモフモフは不死",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 118.64,
  "end": 120.96000000000001,
  "text": "さあ出かける前に",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 120.96000000000001,
  "end": 123.4,
  "text": "その格好じゃーつ",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 123.4,
  "end": 125.98,
  "text": "これで準備は整ったね",
  "avg_logprob": -0.18367722552755605,
  "no_speech_prob": 6.463513751997496e-11
 },
 {
  "start": 125.98,
  "end": 129.48000000000002,
  "text": "さあいってらっしゃーい",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 129.48000000000002,
  "end": 131.28,
  "text": "やおやろー",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 131.28,
  "end": 132.36,
  "text": "神々のみんな",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 132.36,
  "end": 134.46,
  "text": "今日も最高だったー",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 134.46,
  "end": 135.8,
  "text": "ここでお知らせ",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 135.8,
  "end": 139.48000000000002,
  "text": "八千代コップっていうイベントを開催しまーす",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 139.48000000000002,
  "end": 141.76,
  "text": "いつも来てくれてありがとね",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 141.76,
  "end": 145.34,
  "text": "この前は帝様側についてましてよ",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 145.34,
  "end": 147.42000000000002,
  "text": "絶対かとうね",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 147.42000000000002,
  "end": 151.34,
  "text": "でに恐ろしき狙撃能力",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 151.34,
  "end": 153.42000000000002,
  "text": "パンケーキいいなー",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 153.42000000000002,
  "end": 155.8,
  "text": "八千代も食べたいなー",
  "avg_logprob": -0.24440765380859375,
  "no_speech_prob": 3.989849423069458e-11
 },
 {
  "start": 155.8,
  "end": 156.8,
  "text": "よよよよ",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 156.8,
  "end": 159.24,
  "text": "八千代は電子の海の歌姫なので",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 159.24,
  "end": 160.68,
  "text": "食べられないのです",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 160.68,
  "end": 163.04000000000002,
  "text": "あれはもう届いたから",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 163.04000000000002,
  "end": 164.72,
  "text": "お役目完了",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 164.72,
  "end": 166.4,
  "text": "みんなー",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 166.4,
  "end": 168.32000000000002,
  "text": "今日は本当にありがとう",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 168.32000000000002,
  "end": 170.56,
  "text": "今は昔",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 170.56,
  "end": 173.82000000000002,
  "text": "月に帰ってバリバリ社畜してた",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 173.82000000000002,
  "end": 175.72000000000003,
  "text": "エラエラかぐや姫のところに",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 175.72000000000003,
  "end": 177.32000000000002,
  "text": "歌が届きました",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 177.32000000000002,
  "end": 181.16000000000003,
  "text": "それでもう一回地球に行こうって",
  "avg_logprob": -0.22470113028467228,
  "no_speech_prob": 4.7951961845704716e-11
 },
 {
  "start": 181.16,
  "end": 185.64,
  "text": "お仕事爆速ですっかり片付けて引き継ぎも関連",
  "avg_logprob": -0.12274036099833827,
  "no_speech_prob": 2.6282203843819296e-11
 },
 {
  "start": 185.64,
  "end": 189.07999999999998,
  "text": "ただ地球の時間では大遅刻",
  "avg_logprob": -0.12274036099833827,
  "no_speech_prob": 2.6282203843819296e-11
 },
 {
  "start": 189.07999999999998,
  "end": 190.35999999999999,
  "text": "でも安心",
  "avg_logprob": -0.12274036099833827,
  "no_speech_prob": 2.6282203843819296e-11
 },
 {
  "start": 190.35999999999999,
  "end": 194.18,
  "text": "月の超テクノロジーは時間も超えられます",
  "avg_logprob": -0.12274036099833827,
  "no_speech_prob": 2.6282203843819296e-11
 },
 {
  "start": 194.18,
  "end": 197.62,
  "text": "時を超えて地球に向かうかぐや姫",
  "avg_logprob": -0.22021050453186036,
  "no_speech_prob": 3.763114819754776e-11
 },
 {
  "start": 197.62,
  "end": 203.1,
  "text": "でももう少しのところででっかーい石に当たっちゃったの",
  "avg_logprob": -0.22021050453186036,
  "no_speech_prob": 3.763114819754776e-11
 },
 {
  "start": 203.1,
  "end": 203.74,
  "text": "やっと",
  "avg_logprob": -0.22021050453186036,
  "no_speech_prob": 3.763114819754776e-11
 },
 {
  "start": 203.74,
  "end": 209.06,
  "text": "見ついたのはざっと八千年も前の地球でした",
  "avg_logprob": -0.22021050453186036,
  "no_speech_prob": 3.763114819754776e-11
 },
 {
  "start": 209.06,
  "end": 212.18,
  "text": "壊れた船のわずかな力で",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 212.18,
  "end": 216.3,
  "text": "同行していた犬同士だけが体を得ました",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 216.3,
  "end": 220.02,
  "text": "かぐやは海牛の体を通してだけ",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 220.02,
  "end": 222.74,
  "text": "世界と交流を持てたのです",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 222.74,
  "end": 224.28,
  "text": "時は経ち",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 224.28,
  "end": 227.64000000000001,
  "text": "人々は見えないものを形にし",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 227.64000000000001,
  "end": 230.94,
  "text": "多くの人とつながる力を手に入れた",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 230.94,
  "end": 234.8,
  "text": "それは月の世界と少し似ていて",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 234.8,
  "end": 236.44,
  "text": "かぐやは初めて",
  "avg_logprob": -0.14149584562882134,
  "no_speech_prob": 2.668811178996311e-11
 },
 {
  "start": 236.44,
  "end": 241.4,
  "text": "魂だけの自分が世界と関われる可能性を知りました",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 241.4,
  "end": 242.5,
  "text": "そして",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 242.5,
  "end": 245.88,
  "text": "仮想世界つくよみの歌姫として",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 245.88,
  "end": 248.98,
  "text": "再びいろはと出会うことができたのです",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 248.98,
  "end": 251.22,
  "text": "それが八千代だから",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 251.22,
  "end": 252.68,
  "text": "ハッピーエンド",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 252.68,
  "end": 254.02,
  "text": "ん",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 254.02,
  "end": 257.3,
  "text": "連れてくって約束したのに",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 257.3,
  "end": 259.76,
  "text": "いろはの歌を聞いて戻ってきた",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 259.76,
  "end": 261.26,
  "text": "ごめん",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
 },
 {
  "start": 261.26,
  "end": 262.08,
  "text": "閉じっちゃった",
  "avg_logprob": -0.17628425775572312,
  "no_speech_prob": 2.4789918381951104e-11
